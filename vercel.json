{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "motionhub.kr" }],
      "destination": "/motionhub.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.motionhub.kr" }],
      "destination": "/motionhub.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/motionhub.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/motionhub-og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ]
}
