VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# 선택: 커스텀 도메인 연결 시 (예: https://your-domain.com)
# VITE_SITE_URL=https://your-domain.com

# 선택: Sentry 오류 모니터링 (없으면 비활성)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# --- 아래는 Supabase Edge Function Secrets (Vercel이 아닌 Supabase 대시보드에 설정) ---
# NOTIFICATION_INTERNAL_SECRET=your-random-secret-string
# NOTIFICATION_CRON_SECRET=your-cron-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MESSAGING_ENABLED=true
# SITE_URL=https://motionhub.kr
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_PF_ID=           # MotionHub 카카오 채널 프로필 ID
# SOLAPI_FROM_NUMBER=     # 문자 대체발송용 발신번호
# SOLAPI_TEMPLATE_WELCOME=    # 알림톡 템플릿 ID
# SOLAPI_TEMPLATE_PAYMENT=
# SOLAPI_TEMPLATE_RENEWAL=
# SOLAPI_TEMPLATE_STEP_RESULT=
# SOLAPI_TEMPLATE_PT_REMINDER=

# 토스페이먼츠 클라이언트 키 (온라인 결제 연동 시)
# VITE_TOSS_CLIENT_KEY=test_ck_...
